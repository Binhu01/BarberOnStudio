{
  "expo": {
    "name": "Barber-On",
    "slug": "barber-on",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "barber-on",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#3563F5",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.barber-on.app",
      "infoPlist": {
        "NSCameraUsageDescription": "A Barber-On precisa da câmera para anexar imagens.",
        "NSPhotoLibraryUsageDescription": "A Barber-On precisa acessar suas fotos para anexar imagens."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3563F5"
      },
      "package": "com.barber-on.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "VIBRATE",
        "NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "SEU_EAS_PROJECT_ID_AQUI"
      }
    },
    "_comment_eas": "Para obter o projectId: npx eas init (dentro de apps/mobile). Requer conta em expo.dev."
  }
}