# =============================================================================
# BARBER-ON STUDIO — Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env.local e preencha os valores.
# Variáveis marcadas como [OBRIGATÓRIA] devem ser definidas para o app funcionar.
# Variáveis marcadas como [OPCIONAL] possuem valor padrão no código.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (Auth + Database)
# -----------------------------------------------------------------------------
# [OBRIGATÓRIA] URL do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# [OBRIGATÓRIA] Chave anônima do Supabase (segura para uso no browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# [OBRIGATÓRIA] Service Role Key (NUNCA exponha no frontend — apenas server-side)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -----------------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------------
# [OBRIGATÓRIA] URL pública da aplicação (usada em emails, webhooks, redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# [OPCIONAL] Nome exibido na UI e em comunicações
NEXT_PUBLIC_APP_NAME=Barber-On Studio

# [OPCIONAL] Slug da barbearia para página pública de agendamento
NEXT_PUBLIC_BARBER_SLUG=barber-on-studio

# -----------------------------------------------------------------------------
# WhatsApp Business Cloud API (Meta)
# -----------------------------------------------------------------------------
# [OBRIGATÓRIA para WhatsApp] Phone Number ID da conta WhatsApp Business
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# [OBRIGATÓRIA para WhatsApp] Access Token permanente ou temporário
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token

# [OBRIGATÓRIA para webhook] Verify Token configurado no painel Meta
WHATSAPP_VERIFY_TOKEN=your-verify-token

# [OPCIONAL] URL da API Graph (default: https://graph.facebook.com/v21.0)
WHATSAPP_API_URL=https://graph.facebook.com/v21.0

# -----------------------------------------------------------------------------
# Email — Resend
# -----------------------------------------------------------------------------
# [OBRIGATÓRIA para email] Chave da API Resend para notificações
RESEND_API_KEY=re_xxxxx

# [OPCIONAL] Email remetente padrão
RESEND_FROM_EMAIL=noreply@barberon.studio

# -----------------------------------------------------------------------------
# Mercado Pago — Pagamentos na Barbearia
# -----------------------------------------------------------------------------
# [OBRIGATÓRIA para pagamentos] Access Token do Mercado Pago da barbearia
MP_ACCESS_TOKEN=APP_USR-xxxx...

# [OBRIGATÓRIA para webhook] Segredo para verificação de assinatura do webhook MP
MP_WEBHOOK_SECRET=webhook-secret-here

# [OPCIONAL] URL da API do Mercado Pago (default: https://api.mercadopago.com)
MP_API_URL=https://api.mercadopago.com

# -----------------------------------------------------------------------------
# Anthropic AI — Assistente IA
# -----------------------------------------------------------------------------
# [OBRIGATÓRIA para IA] Chave da API Anthropic para o assistente inteligente
ANTHROPIC_API_KEY=sk-ant-xxxx...

# [OPCIONAL] Modelo Anthropic a ser usado (default: claude-sonnet-4-20250514)
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# -----------------------------------------------------------------------------
# App Mobile (Expo / React Native)
# -----------------------------------------------------------------------------
# [OBRIGATÓRIA para mobile] Mesma URL do Supabase usada no web
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# [OBRIGATÓRIA para mobile] Mesma chave anônima usada no web
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here